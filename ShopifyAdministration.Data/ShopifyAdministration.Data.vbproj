<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TMM_Shopify_Administration</RootNamespace>
    <OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.Data" />
    <Compile Include="../Shopify-Administration/Data/*.vb" Link="Data/%(Filename)%(Extension)" />
    <Compile Include="../Shopify-Administration/Api/BulkQueries.vb" Link="BulkQueries.vb" />
    <Compile Include="../Shopify-Administration/ShopifyQueries.vb" Link="ShopifyQueries.vb" />
    <ProjectReference Include="../ShopifyAdministration.Core/ShopifyAdministration.Core.csproj" />
    <PackageReference Include="CompuMaster.Data" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
