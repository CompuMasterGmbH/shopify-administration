<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ShopifyAdministration.Desktop.MainWindow" Title="Shopify Administration" Width="1180" Height="760" MinWidth="780" MinHeight="640">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="Gray">
      <TextBlock Name="Status" Text="Nicht angemeldet" TextWrapping="Wrap" />
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="16" Spacing="10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="Shopify Administration" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Name="CheckUpdates" Content="Nach Updates suchen" Click="OnCheckUpdates" />
        <Button Grid.Column="2" Name="Account" Content="Abmelden / Konto wechseln" Click="Logout" IsVisible="False" />
        <Button Grid.Column="3" Name="CancelLoad" Content="Abruf abbrechen" Click="CancelLoadClick" IsVisible="False" />
      </Grid>
      <Grid Name="UpdateNotice" IsVisible="False" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Name="UpdateMessage" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="OpenUpdate" Content="Download öffnen" Click="OnOpenUpdate" IsVisible="False" />
        <Button Grid.Column="2" Name="SkipUpdate" Content="Version überspringen" Click="OnSkipUpdate" IsVisible="False" />
        <Button Grid.Column="3" Name="LaterUpdate" Content="Später" Click="OnLaterUpdate" />
      </Grid>
      <WrapPanel Name="Actions" IsVisible="False">
        <Button Name="Products" Content="Produkte" Tag="Products" Click="LoadData" Margin="0,0,8,8" />
        <Button Content="Kategorien" Tag="Collections" Click="LoadData" Margin="0,0,8,8" />
        <Button Content="Smart Collections" Tag="SmartCollections" Click="LoadData" Margin="0,0,8,8" />
        <Button Content="Transfers (lesen)" Tag="Transfers" Click="LoadData" Margin="0,0,8,8" />
        <Button Content="Lieferanten / Bestellungen" Click="ExplainPurchasing" Margin="0,0,8,8" />
        <Button Content="API-Browser" Click="OpenBrowser" Margin="0,0,8,8" />
        <Button Name="Export" Content="Excel exportieren" Click="ExportData" IsEnabled="False" Margin="0,0,8,8" />
      </WrapPanel>
      <ProgressBar Name="Progress" Height="4" IsIndeterminate="True" IsVisible="False" />
    </StackPanel>
    <Grid>
      <ContentControl Name="LoginHost" />
      <DataGrid Name="Results" IsVisible="False" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All" Margin="16,0,16,16" />
    </Grid>
  </DockPanel>
</Window>
