<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ShopifyAdministration.Desktop.LoginView">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="12" MaxWidth="660" HorizontalAlignment="Stretch">
      <TextBlock Text="Bei Shopify anmelden" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="Shop-API-URL" />
      <TextBox Name="ApiUrl" AutomationProperties.Name="Shop-API-URL" Text="{Binding ApiUrl, Mode=TwoWay}" PlaceholderText="https://shop.myshopify.com/admin/api/JJJJ-MM/" />
      <TextBlock Text="API-Schlüssel / Benutzer (leer bei Access-Token)" />
      <TextBox Name="ApiKey" AutomationProperties.Name="API-Schlüssel / Benutzer" Text="{Binding ApiKey, Mode=TwoWay}" />
      <TextBlock Text="Passwort / Access-Token" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Name="Password" AutomationProperties.Name="Passwort / Access-Token" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" />
        <Button Grid.Column="1" Name="ShowPassword" Content="Anzeigen" Click="TogglePassword" />
      </Grid>
      <CheckBox Name="Remember" IsChecked="{Binding Remember, Mode=TwoWay}" IsEnabled="{Binding CanPersist}" Content="URL und Zugangsdaten auf diesem Computer verschlüsselt speichern" />
      <TextBlock Name="LoginMessage" Text="{Binding Message}" TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="SignIn" Content="Anmelden" Click="OnSignIn" IsDefault="True" />
        <Button Name="CancelLogin" Content="Abbrechen" Click="OnCancelLogin" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
